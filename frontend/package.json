{
  "name": "travel-comparison-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-data": "node -e \"for (const f of ['scenarios.json','recorded_baseline.json']) require('fs').copyFileSync('../web/'+f,'public/'+f)\"",
    "predev": "npm run sync-data",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run sync-data",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "7.0.2",
    "vite": "6.4.2"
  }
}

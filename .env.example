# Copy to .env (never commit .env). Systems B and C only; system A needs no LLM.
# Same model, temperature=0, max_tokens and seed for B and C. Zero-cost options only.

# --- default: free local model through Ollama (https://ollama.com) ---
#   ollama pull qwen2.5:7b-instruct
LLM_MODEL=ollama/qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434

# --- optional: free-tier hosted provider (uncomment ONE) ---
# Google AI Studio free tier (native in CrewAI):
# LLM_MODEL=gemini/gemini-2.0-flash
# GEMINI_API_KEY=
# Groq free tier (routed through LiteLLM: pip install litellm):
# LLM_MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_SEED=42
LLM_TIMEOUT_S=120
# Shared local Gemini pacing; applies across B/C workers. External usage can still consume quota.
LLM_RPM=12

# Weather: fixture (default, reads data/weather/*.json, used by the eval) | live (Open-Meteo, free, no key)
WEATHER_MODE=fixture

# CrewAI telemetry off
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# Optional OpenAI provider (usage may be billed by your account):
# LLM_MODEL=openai/your-available-model-name
# OPENAI_API_KEY=

# Remote frontend origins, comma-separated; local defaults are provided:
# TRAVEL_ALLOWED_ORIGINS=https://your-interface.example
